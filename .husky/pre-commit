#!/usr/bin/env sh
set -eu

# staged 변경에서 비밀키 검사 (gitleaks가 설치된 경우)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged .
else
  echo "gitleaks 미설치: 비밀키 검사를 건너뜁니다."
fi

# n8n workflow JSON 문법 검증
if command -v jq >/dev/null 2>&1; then
  find n8n -name '*.json' -print0 | xargs -0 jq empty
else
  echo "jq 미설치: n8n JSON 검사를 건너뜁니다."
fi

# Python 문법 검증
if command -v python3 >/dev/null 2>&1; then
  python3 -m py_compile model/emotion/app.py model/embedding/app.py
else
  echo "python3 미설치: Python 문법 검사를 건너뜁니다."
fi
